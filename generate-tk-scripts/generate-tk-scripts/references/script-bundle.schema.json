{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/generate-tk-scripts/script-bundle.schema.json",
  "title": "TK script bundle v1",
  "type": "object",
  "required": [
    "pipeline_id",
    "artifact_type",
    "schema_version",
    "generated_at",
    "source_breakdown",
    "videos"
  ],
  "properties": {
    "pipeline_id": {
      "const": "tk-content-pipeline/v1"
    },
    "artifact_type": {
      "const": "script_bundle"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_breakdown": {
      "type": "string",
      "minLength": 1
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/video_scripts"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hook_comparison": {
      "type": "object",
      "required": [
        "original_hook",
        "optimized_hook",
        "key_changes",
        "intended_retention_effect"
      ],
      "properties": {
        "original_hook": {
          "type": "string",
          "minLength": 1
        },
        "optimized_hook": {
          "type": "string",
          "minLength": 1
        },
        "key_changes": {
          "type": "string",
          "minLength": 1
        },
        "intended_retention_effect": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "start_second",
        "end_second",
        "voiceover",
        "visual_action",
        "purpose"
      ],
      "properties": {
        "start_second": {
          "type": "number",
          "minimum": 0
        },
        "end_second": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "voiceover": {
          "type": "string",
          "minLength": 1
        },
        "visual_action": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": ["留人", "解释", "证明", "信任", "下单"]
        }
      },
      "additionalProperties": false
    },
    "humanity_review": {
      "type": "object",
      "required": [
        "status",
        "humanity_score",
        "feed_score",
        "sales_score",
        "ai_tells",
        "read_aloud_issues",
        "revision_rounds",
        "voice_evidence_gap"
      ],
      "properties": {
        "status": {"enum": ["approved", "rejected"]},
        "humanity_score": {"type": "number", "minimum": 0, "maximum": 5},
        "feed_score": {"type": "number", "minimum": 0, "maximum": 5},
        "sales_score": {"type": "number", "minimum": 0, "maximum": 5},
        "ai_tells": {"type": "array", "items": {"type": "string"}},
        "read_aloud_issues": {"type": "array", "items": {"type": "string"}},
        "revision_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
        "voice_evidence_gap": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "script": {
      "type": "object",
      "required": [
        "script_id",
        "group",
        "route",
        "variant",
        "test_variable",
        "shell_direction",
        "new_purchase_path",
        "fixed_invariants",
        "hook_comparison",
        "segments",
        "final_voiceover",
        "estimated_duration_seconds",
        "duration_note"
      ],
      "properties": {
        "script_id": {
          "type": "string",
          "pattern": "^SC-.+-(ITER|RESHELL|NEWLOGIC)-[ABC]$"
        },
        "group": {
          "enum": ["iteration", "reshell", "new_logic"]
        },
        "route": {
          "enum": ["原逻辑迭代", "原逻辑换壳", "新底层逻辑"]
        },
        "variant": {
          "enum": ["A", "B", "C"]
        },
        "test_variable": {
          "type": "string"
        },
        "shell_direction": {
          "type": "string"
        },
        "new_purchase_path": {
          "type": "string"
        },
        "fixed_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hook_comparison": {
          "$ref": "#/$defs/hook_comparison"
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/segment"
          }
        },
        "final_voiceover": {
          "type": "string",
          "minLength": 1
        },
        "estimated_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_note": {
          "type": "string"
        },
        "humanity_review": {
          "$ref": "#/$defs/humanity_review"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"group": {"const": "iteration"}},
            "required": ["group"]
          },
          "then": {
            "properties": {
              "test_variable": {"minLength": 1},
              "shell_direction": {"maxLength": 0},
              "new_purchase_path": {"maxLength": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"group": {"const": "reshell"}},
            "required": ["group"]
          },
          "then": {
            "properties": {
              "test_variable": {"maxLength": 0},
              "shell_direction": {"minLength": 1},
              "new_purchase_path": {"maxLength": 0}
            }
          }
        },
        {
          "if": {
            "properties": {"group": {"const": "new_logic"}},
            "required": ["group"]
          },
          "then": {
            "properties": {
              "test_variable": {"maxLength": 0},
              "shell_direction": {"maxLength": 0},
              "new_purchase_path": {"minLength": 1}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "video_scripts": {
      "type": "object",
      "required": ["video_id", "scripts"],
      "properties": {
        "video_id": {
          "type": ["string", "integer"]
        },
        "source_duration_seconds": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "scripts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/script"
          },
          "oneOf": [
            {
              "minItems": 6,
              "maxItems": 6,
              "allOf": [
                {
                  "contains": {
                    "properties": {"group": {"const": "iteration"}},
                    "required": ["group"]
                  },
                  "minContains": 2,
                  "maxContains": 2
                },
                {
                  "contains": {
                    "properties": {"group": {"const": "reshell"}},
                    "required": ["group"]
                  },
                  "minContains": 2,
                  "maxContains": 2
                },
                {
                  "contains": {
                    "properties": {"group": {"const": "new_logic"}},
                    "required": ["group"]
                  },
                  "minContains": 2,
                  "maxContains": 2
                },
                {
                  "contains": {
                    "properties": {"variant": {"const": "C"}},
                    "required": ["variant"]
                  },
                  "minContains": 0,
                  "maxContains": 0
                }
              ]
            },
            {
              "minItems": 9,
              "maxItems": 9,
              "allOf": [
                {
                  "contains": {"properties": {"group": {"const": "iteration"}}},
                  "minContains": 3,
                  "maxContains": 3
                },
                {
                  "contains": {"properties": {"group": {"const": "reshell"}}},
                  "minContains": 3,
                  "maxContains": 3
                },
                {
                  "contains": {"properties": {"group": {"const": "new_logic"}}},
                  "minContains": 3,
                  "maxContains": 3
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
