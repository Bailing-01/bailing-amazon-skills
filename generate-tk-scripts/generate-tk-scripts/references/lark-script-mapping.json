{
  "schema_version": 1,
  "logical_table": "scripts",
  "logical_business_key": "脚本ID",
  "physical_business_key": {
    "name": "素材ID",
    "type": "text",
    "source": "script_id",
    "required": true
  },
  "select_value_maps": {
    "group_to_route": {
      "iteration": "原逻辑迭代",
      "reshell": "原逻辑换壳",
      "new_logic": "新底层逻辑"
    },
    "validated_status": "待审核",
    "record_type": "新素材方案",
    "audit_pass": "通过"
  },
  "fields": [
    {
      "source": "script_id",
      "name": "素材ID",
      "type": "text",
      "required": true
    },
    {
      "source": "derived:{video_id}｜{route}-{variant}",
      "name": "素材名称",
      "type": "text",
      "required": true
    },
    {
      "source": "variant",
      "name": "素材版本",
      "type": "select",
      "allowed": ["A", "B", "C"],
      "required": true
    },
    {
      "source": "group",
      "transform": "select_value_maps.group_to_route",
      "name": "创意路线",
      "type": "select",
      "allowed": ["原逻辑迭代", "原逻辑换壳", "新底层逻辑"],
      "required": true
    },
    {
      "source": "constant:新素材方案",
      "name": "记录类型",
      "type": "select",
      "allowed": ["新素材方案"],
      "required": true
    },
    {
      "source": "constant:待审核_after_strict_validation",
      "name": "素材状态",
      "type": "select",
      "allowed": ["待审核"],
      "required": true
    },
    {
      "source": "target_audience",
      "name": "目标人群",
      "type": "text",
      "required": false
    },
    {
      "source": "original_bottom_logic",
      "name": "原底层逻辑",
      "type": "text",
      "required": false
    },
    {
      "source": "new_purchase_path",
      "name": "新底层逻辑",
      "type": "text",
      "required": false
    },
    {
      "source": "first_nonempty(test_variable,shell_direction,new_purchase_path)",
      "name": "创意方向",
      "type": "text",
      "required": true
    },
    {
      "source": "first_nonempty(test_variable,prefix(shell_direction,仅更换表现外壳：),prefix(new_purchase_path,仅更换底层购买路径：))",
      "name": "唯一测试变量",
      "type": "text",
      "required": true
    },
    {
      "source": "join(fixed_invariants,；)",
      "name": "固定不变项",
      "type": "text",
      "required": true
    },
    {
      "source": "hook_comparison.optimized_hook",
      "name": "Hook",
      "type": "text",
      "required": true
    },
    {
      "source": "format_segments(segments)",
      "name": "秒级分镜",
      "type": "text",
      "required": true
    },
    {
      "source": "final_voiceover",
      "name": "完整中文口播",
      "type": "text",
      "required": true
    },
    {
      "source": "final_voiceover",
      "name": "输出新脚本",
      "type": "text",
      "required": true
    },
    {
      "source": "estimated_duration_seconds",
      "name": "预计时长秒",
      "type": "number",
      "required": true
    },
    {
      "source": "join(segments[].visual_action,\n)",
      "name": "拍摄清单",
      "type": "text",
      "required": false
    },
    {
      "source": "derived:strict_validator_pass",
      "name": "距离审计结果",
      "type": "select",
      "allowed": ["通过"],
      "required": true
    },
    {
      "source": "derived:strict_validator_pass",
      "name": "节奏审计",
      "type": "select",
      "allowed": ["通过"],
      "required": true
    },
    {
      "source": "derived:hook_comparison_and_duration_note",
      "name": "备注",
      "type": "text",
      "required": true
    },
    {
      "source": "constant:本批脚本已生成并通过本地结构校验，待人工审核。",
      "name": "审核意见",
      "type": "text",
      "required": true
    }
  ],
  "optional_component_fields": [
    {"source": "script_components.retention_boost", "name": "留人加码", "type": "text"},
    {"source": "script_components.pain", "name": "痛点", "type": "text"},
    {"source": "script_components.turn", "name": "转折", "type": "text"},
    {"source": "script_components.product_entry", "name": "产品切入", "type": "text"},
    {"source": "script_components.product_mechanism", "name": "产品机制", "type": "text"},
    {"source": "script_components.product_benefits", "name": "产品卖点", "type": "text"},
    {"source": "script_components.trust_proof", "name": "信任证明", "type": "text"},
    {"source": "script_components.offer", "name": "Offer", "type": "text"},
    {"source": "script_components.cta", "name": "CTA", "type": "text"}
  ],
  "optional_verified_links": [
    {
      "source": "source_original_record_id",
      "name": "来源原视频",
      "type": "link",
      "link_table": "original_videos",
      "write_only_if_real_record_id": true
    },
    {
      "source": "product_record_id",
      "name": "关联产品",
      "type": "link",
      "link_table": "products",
      "write_only_if_real_record_id": true
    }
  ],
  "forbidden_fields": [
    {
      "name": "来源拆解",
      "reason": "只有现场确认该关联指向本机绑定的 step2_breakdowns 表时才可写入"
    },
    {"name": "使用Hook元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用留人元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用人群痛点元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用机制卖点元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用信任背书元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用OfferCTA元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"},
    {"name": "使用底层逻辑元素", "reason": "本 Skill 禁止写入或依赖 03 表关联"}
  ]
}
